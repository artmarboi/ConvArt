{
  "name": "convart",
  "version": "1.0.0",
  "description": "ConvArt - High-speed Media Compressor & Converter by artmarboi",
  "main": "electron/main.cjs",
  "author": "artmarboi",
  "scripts": {
    "start": "node server/api.cjs",
    "dev:vite": "vite",
    "dev:server": "node server/api.cjs",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:vite\"",
    "app": "electron .",
    "build": "vite build",
    "package": "electron-builder"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "electron-updater": "^6.8.11",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "multer": "^1.4.5-lts.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.2.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.artmarboi.convart",
    "productName": "ConvArt",
    "compression": "maximum",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "artmarboi",
        "repo": "ConvArt"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "ConvArt.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      },
      {
        "from": "ConvArt.ico",
        "to": "ConvArt.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "ConvArt.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ConvArt",
      "installerIcon": "ConvArt.ico",
      "uninstallerIcon": "ConvArt.ico",
      "installerHeaderIcon": "ConvArt.ico",
      "artifactName": "ConvArt-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "ConvArt-Portable.${ext}"
    }
  }
}
